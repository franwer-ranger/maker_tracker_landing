---
// Inline SVG icons: Heroicons outline 24 (stroke 1.5) plus the GitHub mark (Octicons).
// Only the icons in use are copied into src/icons/.
interface Props {
  name: "arrow-right" | "check" | "command-line" | "document-duplicate" | "github";
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const icons = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });
const svg = icons[`../icons/${name}.svg`].replace(
  "<svg ",
  `<svg width="${size}" height="${size}" class="icon${className ? ` ${className}` : ""}" focusable="false" `,
);
---

<Fragment set:html={svg} />
